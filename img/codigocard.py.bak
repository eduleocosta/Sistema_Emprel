from PIL import Image
import numpy as np

# abrir imagem
img = Image.open(r"C:\Users\EMPREL03\Desktop\Sistema Emprel 03\img\resultado_final.png").convert("RGB")

# converter para array
np_img = np.array(img)

# separar canais
r, g, b = np_img[:,:,0], np_img[:,:,1], np_img[:,:,2]

# máscara: identificar tons de azul
mask = (b > 100) & (b > r) & (b > g)

# nova cor (exemplo: vermelho)
nova_cor = (200, 30, 30)

# aplicar mantendo intensidade
np_img[mask] = [
    nova_cor[0],
    nova_cor[1],
    nova_cor[2]
]

# salvar
nova_img = Image.fromarray(np_img)
nova_img.save(r"C:\Users\EMPREL03\Desktop\Sistema Emprel 03\img\Card.png")

print("Cor alterada!")