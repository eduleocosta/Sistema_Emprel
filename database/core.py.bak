def carregar_historico_backup():
    if not os.path.exists(HISTORICO_BACKUP):
        return {
            "ultimo_backup": None,
            "ultimo_restore": None
        }
    try:
        with open(HISTORICO_BACKUP, "r", encoding="utf-8") as f:
            return json.load(f)
    except:
        return {
            "ultimo_backup": None,
            "ultimo_restore": None
        }

def salvar_historico_backup(historico):
    with open(HISTORICO_BACKUP, "w", encoding="utf-8") as f:
        json.dump(historico, f, indent=4, ensure_ascii=False)

def valores_lista_tree(tree):
    dados = []
    for item in tree.get_children():
        valores = tree.item(item)["values"]
        if valores:
            dados.append(list(valores))
    return dados

ARQ_LISTA_ENTREGA = os.path.join(PASTA_LISTAS, "lista_final_atual.json")

def salvar_lista_tree(tree, nome_arquivo=None, metadados=None):
    os.makedirs(PASTA_LISTAS, exist_ok=True)
    dados = valores_lista_tree(tree)
    caminho = ARQ_LISTA_ENTREGA if not nome_arquivo else os.path.join(PASTA_LISTAS, nome_arquivo)
    payload = {
        "metadados": metadados or {},
        "itens": dados
    }
    with open(caminho, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=2)
    return os.path.basename(caminho)

def carregar_lista_tree(tree, nome_arquivo=None):
    caminho = ARQ_LISTA_ENTREGA if not nome_arquivo else os.path.join(PASTA_LISTAS, nome_arquivo)
    if not os.path.exists(caminho):
        return
    try:
        with open(caminho, "r", encoding="utf-8") as f:
            dados = json.load(f)
        if isinstance(dados, dict):
            dados = dados.get("itens", [])
        for linha in dados:
            tree.insert("", "end", values=linha[:4])
    except:
        pass

def salvar_excluido(nome_arquivo, tipo, item, usuario_logado):
    historico = []
    if os.path.exists(nome_arquivo):
        with open(nome_arquivo, "r", encoding="utf-8") as f:
            try:
                historico = json.load(f)
            except:
                historico = []
    historico.append({
        "tipo": tipo,
        "data_exclusao": datetime.now().strftime("%d/%m/%Y %H:%M:%S"),
        "operador": usuario_logado,
        "dados": item
    })
    with open(nome_arquivo, "w", encoding="utf-8") as f:
        json.dump(historico, f, indent=4, ensure_ascii=False)

def registrar_entrega_json_separado(lista_dados, usuario_logado):
    from config import DB_ENTREGAS
    if os.path.exists(DB_ENTREGAS):
        with open(DB_ENTREGAS, "r", encoding="utf-8") as f:
            try:
                entregas = json.load(f)
            except:
                entregas = []
    else:
        entregas = []
    timestamp = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
    for item in lista_dados:
        data_entrega = item.get("data_entrega") or timestamp
        registro = {
            "data_entrega_registro": data_entrega,
            "operador": usuario_logado,
            "protocolo": item.get("protocolo", ""),
            "nome": item.get("nome", ""),
            "cpf": item.get("cpf", ""),
            "telefone": item.get("telefone", ""),
            "data_acao": item.get("data", ""),
            "acao": item.get("acao", ""),
            "acao_id": item.get("acao_id", ""),
            "servico_id": item.get("servico_id", "")
        }
        entregas.append(registro)
    with open(DB_ENTREGAS, "w", encoding="utf-8") as f:
        json.dump(entregas, f, indent=4, ensure_ascii=False)